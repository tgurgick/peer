# Peer Configuration

# Data directory (default: ~/.peer)
PEER_DATA_DIR=~/.peer

# Default operating mode (1-4)
# 1 = Logs only (silent)
# 2 = Logs + screenshots
# 3 = Logs + screenshots + periodic AI summaries
# 4 = Logs + screenshots + real-time AI feedback
PEER_DEFAULT_MODE=1

# Screenshot capture interval in seconds (for modes 2-4)
PEER_SCREENSHOT_INTERVAL=60

# AI summary interval in seconds (for modes 3-4)
PEER_SUMMARY_INTERVAL=300

# LLM API Keys (at least one required for AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
